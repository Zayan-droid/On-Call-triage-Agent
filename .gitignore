# ---- Secrets: never commit anything in this block ----
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
credentials
.aws/
*_credentials*
*secret*
!*secrets.example*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Lambda / build artifacts ----
*.zip
build/
dist/
.aws-sam/
package/

# ---- IDE / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---- Eval results ----
# Full run payloads carry every tool call and metric datapoint (~800KB per
# 38-case run). They are the local audit record. The committed artifact is the
# matching *.summary.json, which keeps the scores and drops the traces.
eval/results/*.json
!eval/results/*.summary.json

# ---- Coverage ----
.coverage
.coverage.*
htmlcov/
coverage.xml
