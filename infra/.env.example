# Copy to infra/.env and edit. Both setup.sh and teardown.sh source it if it
# exists, so every value below can be set once instead of exported on each run.
#
#   cp infra/.env.example infra/.env
#
# infra/.env is git-ignored. Nothing here is a secret except TRIAGE_API_KEY,
# and that one is why the ignore rule exists.

# ---- required ----

# Bedrock model access is per account per region, and us-east-1 has the widest
# availability. `setup.sh preflight` checks the model is actually visible here
# before anything is created.
AWS_REGION=us-east-1

# Where a page arrives. Leave this unset and setup.sh creates the SNS topic
# with no subscription, which accepts publishes and delivers nothing -- so the
# agent looks like it paged and no page ever lands.
PAGER_EMAIL=you@example.com

# ---- the model ----

# Both are needed, and this is the single most common Bedrock AccessDenied:
# IAM has to grant the inference-profile ARN in your account AND the bare
# foundation-model ARN in every region the profile can route to. The error
# message does not say so.
MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
FOUNDATION_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Which system prompt the deployed agent runs. v1_baseline and
# v2_investigate_first differ on exactly one axis -- see docs/DESIGN_DECISIONS
# D-19 -- and the measured difference between them is the project's result.
PROMPT_VARIANT=v2_investigate_first

# ---- auth ----

# A shared secret, checked with hmac.compare_digest. Deliberately the wrong
# amount of auth for production: the README says so, and the answer there is an
# API Gateway JWT authorizer or an EventBridge invoke with no public surface.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave it empty and the endpoint is open to anyone who finds the URL.
# TRIAGE_API_KEY=

# ---- names (defaults are fine; override only to run two copies side by side) ----

# FUNCTION_NAME=triage-agent
# ROLE_NAME=triage-agent-role
# TABLE_NAME=triage-agent
# TOPIC_NAME=triage-oncall-pages
# API_NAME=triage-agent-api

# Log retention. The default for a new group is "never expire", which is a
# slow, silent bill rather than a visible one.
# LOG_RETENTION_DAYS=14

# ---- the ECS Fargate eval runner (optional; needs Docker) ----

# ECR_REPO_NAME=triage-eval-runner
# ECS_TASK_FAMILY=triage-eval-runner
# ECS_CLUSTER_NAME=triage-eval
# IMAGE_TAG=latest

# The default VPC is used unless these are set. Set them if the account has no
# default VPC, or to run the sweep in private subnets -- which then needs NAT
# or VPC endpoints for Bedrock, DynamoDB, CloudWatch and ECR, because the task
# has no other route out.
# ECS_SUBNET_IDS=subnet-aaaa,subnet-bbbb
# ECS_SECURITY_GROUP_ID=sg-cccc

# ---- Bedrock AgentCore Runtime (optional; needs Docker with arm64 support) ----

# The runtime name must match [A-Za-z][A-Za-z0-9_]{0,47} -- hyphens are
# rejected, which is why this one is underscored while everything else is not.
# AGENTCORE_RUNTIME_NAME=triage_agent
# AGENTCORE_REPO_NAME=triage-agentcore
# AGENTCORE_ROLE_NAME=triage-agentcore-role
