# The triage agent as a Bedrock AgentCore Runtime container.
#
# AgentCore Runtime is the third way this same agent can be deployed, after
# Lambda behind API Gateway and a direct invoke. It runs a container and speaks
# HTTP to it rather than invoking a function, so the only new code is the
# transport in agent/server.py -- auth, validation, the Converse loop, the five
# tools and the metrics are the same modules the Lambda uses. See
# docs/decisions.md ADR-5 for why this is a second deployment target rather
# than a replacement for the Lambda.
#
# Built and pushed by `bash infra/setup.sh agentcore_image`.

# ARM64 is not a preference: AgentCore Runtime accepts linux/arm64 only, and
# rejects an amd64 image at CreateAgentRuntime with an error that never
# mentions architecture. On an x86 build host that needs buildx and QEMU.
#
# The architecture is requested by the *builder* -- `--platform linux/arm64` in
# setup.sh, `platforms: linux/arm64` in CI -- and deliberately not pinned here.
# A constant `FROM --platform=...` overrides whatever the build asked for,
# which is how a multi-platform build silently produces one architecture, and
# BuildKit lints it (FromPlatformFlagConstDisallowed) for that reason. Both
# callers pass the platform, and a test asserts they still do.
FROM public.ecr.aws/docker/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install -r requirements.txt

# Only the agent package. The eval harness is not part of the deployed agent --
# shipping the scorers and the scripted model inside the thing they grade would
# be both pointless and confusing.
COPY agent/ ./agent/

RUN useradd --system --uid 10001 --user-group --shell /usr/sbin/nologin agent
USER agent

# AgentCore requires 8080 and does not negotiate.
EXPOSE 8080

# No HEALTHCHECK instruction: AgentCore polls GET /ping itself and a
# container-level healthcheck would be a second, unread opinion about the same
# thing. `python -m` rather than a script path so imports resolve identically
# to every other entrypoint in this project.
ENTRYPOINT ["python", "-m", "agent.server"]
