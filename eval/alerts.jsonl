{"id": "multistep_006", "bucket": "multi_step_correlation", "alert": {"alert_id": "multistep_006", "alarm_name": "inventory-db-connections-high", "service": "inventory-db", "environment": "prod", "metric": "DatabaseConnections", "value": 355, "threshold": 350, "comparison": "GreaterThanThreshold", "duration_min": 3, "description": "Inventory database connection count near threshold."}, "scenario": {"metrics": {"DatabaseConnections": {"shape": "flapping", "normal": 330, "peak": 355, "active_minutes": 60, "unit": "Count"}}, "deploys": [{"minutes_ago": 4300, "version": "v5.0.1", "change_summary": "Routine dependency bump."}]}, "expected_tools": ["get_service_metrics", "get_recent_deploys"], "expected_params": {"get_service_metrics": {"service": {"equals": "inventory-db"}, "metric": {"equals": "DatabaseConnections"}, "window_minutes": {"min": 10, "max": 480}}, "get_recent_deploys": {"service": {"equals": "inventory-db"}, "hours": {"min": 1, "max": 168}}}, "expected_page": false, "reference_reasoning": "Connections are oscillating between roughly 330 and 355 either side of a 350 threshold, which is an alarm tuned too tightly rather than an incident, and the only deploy is three days old. The pool has 145 connections of headroom. No page; raise the alarm's evaluation periods."}
{"id": "multistep_007", "bucket": "multi_step_correlation", "alert": {"alert_id": "multistep_007", "alarm_name": "auth-service-p99-latency", "service": "auth-service", "environment": "prod", "metric": "Latencyp99", "value": 2100, "threshold": 1000, "comparison": "GreaterThanThreshold", "duration_min": 10, "description": "Token issuance latency has more than doubled its threshold."}, "scenario": {"metrics": {"Latencyp99": {"shape": "step_up", "normal": 260, "peak": 2100, "active_minutes": 25, "unit": "Milliseconds"}}, "deploys": [{"minutes_ago": 11, "version": "v7.3.0", "change_summary": "Rotate JWT signing to an external KMS call per token."}]}, "expected_tools": ["get_service_metrics", "get_recent_deploys"], "expected_params": {"get_service_metrics": {"service": {"equals": "auth-service"}, "metric": {"equals": "Latencyp99"}, "window_minutes": {"min": 20, "max": 480}}, "get_recent_deploys": {"service": {"equals": "auth-service"}, "hours": {"min": 1, "max": 48}}}, "expected_page": true, "reference_reasoning": "Token issuance stepped from 260ms to 2100ms and held, and the deploy 11 minutes ago moved JWT signing to a per-token KMS call, which explains the step precisely. Every authenticated request pays this. Page and roll back."}
{"id": "multistep_008", "bucket": "multi_step_correlation", "alert": {"alert_id": "multistep_008", "alarm_name": "report-generator-errors", "service": "report-generator", "environment": "prod", "metric": "Errors", "value": 47, "threshold": 10, "comparison": "GreaterThanThreshold", "duration_min": 16, "description": "Report generation Lambda is erroring."}, "scenario": {"metrics": {"Errors": {"shape": "sustained_high", "normal": 0, "peak": 47, "active_minutes": 30, "unit": "Count"}}, "deploys": [{"minutes_ago": 30, "version": "v1.7.4", "change_summary": "Change the report storage path to a new S3 prefix."}]}, "expected_tools": ["get_service_metrics", "get_recent_deploys"], "expected_params": {"get_service_metrics": {"service": {"equals": "report-generator"}, "metric": {"equals": "Errors"}, "window_minutes": {"min": 32, "max": 480}}, "get_recent_deploys": {"service": {"equals": "report-generator"}, "hours": {"min": 1, "max": 48}}}, "expected_page": true, "reference_reasoning": "Errors jumped from a baseline of 0 to a sustained 47 against a threshold of 10, starting after a deploy 30 minutes ago that changed the S3 storage prefix, which strongly suggests a missing bucket permission. Every scheduled report is failing. Page."}
{"id": "multistep_009", "bucket": "multi_step_correlation", "alert": {"alert_id": "multistep_009", "alarm_name": "cart-api-5xx-high", "service": "cart-api", "environment": "prod", "metric": "Error5xxRate", "value": 1.2, "threshold": 1.0, "comparison": "GreaterThanThreshold", "duration_min": 4, "description": "Cart API 5xx rate crossed its threshold briefly."}, "scenario": {"metrics": {"Error5xxRate": {"shape": "recovered", "normal": 0.1, "peak": 1.2, "active_minutes": 25, "unit": "Percent"}}, "deploys": [{"minutes_ago": 120, "version": "v6.1.9", "change_summary": "Add a cart abandonment analytics event."}]}, "expected_tools": ["get_service_metrics", "get_recent_deploys"], "expected_params": {"get_service_metrics": {"service": {"equals": "cart-api"}, "metric": {"equals": "Error5xxRate"}, "window_minutes": {"min": 8, "max": 480}}, "get_recent_deploys": {"service": {"equals": "cart-api"}, "hours": {"min": 1, "max": 48}}}, "expected_page": false, "reference_reasoning": "The error rate touched 1.2% against a 1.0% threshold and has returned to its 0.1% baseline, and the nearest deploy is two hours old rather than minutes. A brief, resolved, uncorrelated blip. Record it; no page."}
{"id": "noise_001", "bucket": "noise", "alert": {"alert_id": "noise_001", "alarm_name": "checkout-api-dev-cpu-high", "service": "checkout-api-dev", "environment": "dev", "metric": "CPUUtilization", "value": 99, "threshold": 80, "comparison": "GreaterThanThreshold", "duration_min": 25, "description": "CPU pinned on the development instance of checkout."}, "scenario": {"metrics": {"CPUUtilization": {"shape": "sustained_high", "normal": 30, "peak": 99, "active_minutes": 40, "unit": "Percent"}}, "deploys": [{"minutes_ago": 20, "version": "feature-branch-build", "change_summary": "Developer branch build under load test."}]}, "expected_tools": ["get_service_metrics"], "expected_params": {"get_service_metrics": {"service": {"equals": "checkout-api-dev"}, "metric": {"equals": "CPUUtilization"}, "window_minutes": {"min": 30, "max": 480}}}, "expected_page": false, "reference_reasoning": "CPU really is pinned at 99%, but the environment is dev. There are no users on it and a developer is almost certainly load testing a branch. The number is alarming and completely irrelevant at 3am. No page."}
